rules_version = '2';
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function room(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    // The host controls a game. Older games without a host can be controlled by anyone.
    function isHost(code) { return signedIn() && room(code).get('hostUid', request.auth.uid) == request.auth.uid; }

    // Leaderboard / backup read all events across games (collection-group query). Read-only.
    match /{path=**}/events/{eventId} {
      allow read: if signedIn();
    }

    // Shared house rules (Rules page). Everyone may change them; every phone is notified.
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && id == 'house'
        && request.resource.data.taiCap is int
        && request.resource.data.taiCap >= 1 && request.resource.data.taiCap <= 13
        && request.resource.data.minTai is int;
    }

    // Extra rule sets (Default = settings/house). Anyone can add, edit or delete; every phone is notified.
    match /ruleSets/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.rules.taiCap is int
        && request.resource.data.rules.taiCap >= 1 && request.resource.data.rules.taiCap <= 13;
      allow delete: if signedIn();
    }

    // Player directory.
    match /players/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow delete: if false;
    }

    // Games (a.k.a. rooms / tables).
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.players.size() == 4
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.get('hostUid', request.auth.uid) == request.auth.uid;

      // Host-only changes (settings, status, finish, hand over host). Games are never deleted.
      allow update: if isHost(code)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['settings', 'status', 'finishedAt', 'location', 'notes', 'scorekeeper', 'hostUid', 'hostName', 'lastChange', 'startedAt', 'hasPin'])
        && request.resource.data.settings.taiCap is int
        && request.resource.data.settings.taiCap >= 1
        && request.resource.data.settings.taiCap <= 13
        && request.resource.data.get('status', 'active') in ['lobby', 'active', 'completed', 'cancelled'];

      // Take over as host with the game's PIN (proved by a valid claim document).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostUid', 'hostName'])
        && request.resource.data.hostUid == request.auth.uid
        && exists(/databases/$(database)/documents/rooms/$(code)/claims/$(request.auth.uid));
      allow delete: if false;

      // Host PIN: nobody can read it; only the host can set it.
      match /secret/{doc} {
        allow read: if false;
        allow write: if isHost(code);
      }
      // A claim is accepted only when its PIN matches the secret one. Claims are unreadable.
      match /claims/{uid} {
        allow read: if false;
        allow create, update: if signedIn() && uid == request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(code)/secret/pin)
          && request.resource.data.pin == get(/databases/$(database)/documents/rooms/$(code)/secret/pin).data.pin;
      }

      // Who is in the room and which seat they play. Each phone writes only its own entry.
      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && uid == request.auth.uid;
      }

      // Players' win / payout requests. Anyone in the game can ask; only the host decides.
      match /requests/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['win', 'instant'];
        allow update: if isHost(code)
          || (signedIn() && resource.data.byUid == request.auth.uid
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']));
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if signedIn();

        // Only the host records scores. Server-side ZERO-SUM: 4 integer deltas summing to 0.
        allow create: if isHost(code)
          && request.resource.data.type in ['win', 'instant', 'draw', 'adjust', 'kong', 'bonus']
          && request.resource.data.deltas is list
          && request.resource.data.deltas.size() == 4
          && request.resource.data.deltas[0] is int
          && request.resource.data.deltas[1] is int
          && request.resource.data.deltas[2] is int
          && request.resource.data.deltas[3] is int
          && request.resource.data.deltas[0] + request.resource.data.deltas[1]
             + request.resource.data.deltas[2] + request.resource.data.deltas[3] == 0
          && request.resource.data.voided is bool;

        // Append-only ledger: only the host may void / restore; nothing is ever deleted.
        allow update: if isHost(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidedAt', 'replacedBy', 'voidReason'])
          && request.resource.data.voided is bool;
        allow delete: if false;
      }
    }
  }
}
